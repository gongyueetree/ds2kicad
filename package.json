{
  "name": "ds2kicad",
  "private": true,
  "version": "0.8.14",
  "type": "module",
  "description": "Datasheet → KiCad symbol / footprint / 3D model extractor with in-browser preview (eetree / ezPLM)",
  "scripts": {
    "dev": "concurrently -k \"node server/dev.js\" \"vite\"",
    "dev:api": "node server/dev.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "e2e": "playwright test",
    "test:pg": "node --test test/pg.test.js",
    "mint-session": "node scripts/mint-session.mjs"
  },
  "dependencies": {
    "@firecrawl/pdf-inspector": "^1.11.2",
    "express": "^4.19.2",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.164.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "vite": "^8.2.0"
  }
}
