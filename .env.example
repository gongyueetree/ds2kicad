# ===== DS2KiCad 环境变量（Vercel → Project Settings → Environment Variables）=====

# Gemini API Key（必填）。v0.8.2 起缺省不再自动 Mock：未配置且未显式 MOCK_MODE=1 时 /api/extract 返回 503
GEMINI_API_KEY=

# Gemini 模型（可选，默认 gemini-2.5-flash）
GEMINI_MODEL=gemini-2.5-flash

# 强制演示模式：1 = 即使配置了 Key 也返回内置 TMUXL27518 样例（用于联调 / ezPLM 集成打通链路）
MOCK_MODE=0

# 允许跨域来源（逗号分隔，用于 ezPLM iframe 集成；留空 = 同源 + *.ezplm.cn/*.eetree.cn 白名单）
ALLOWED_ORIGINS=

# PDF 下载上限（MB，默认 15；Gemini inline 请求上限 20MB）
MAX_PDF_MB=15

# 本地开发 API 端口
PORT=3001

# 混合提取策略：1(默认)=程序化解析优先，AI 仅按需补缺；0=全量走 Gemini
DETERMINISTIC_FIRST=1

# 提取接口总时间预算（毫秒），需小于 Vercel 函数时长上限
EXTRACT_BUDGET_MS=50000

# ezPLM 会话鉴权（item 2/10）：ezPLM 签发的 HS256 会话 JWT 密钥。
# 生产环境必须配置，否则接口 fail closed（503）。浏览器不持有任何密钥，
# 同源 BFF 部署下由 HttpOnly Cookie `ezplm_session` 携带；服务端调用用 Authorization: Bearer。
EZPLM_JWT_SECRET=
# 鉴权模式：production（默认，NODE_ENV=production 时强制）| dev（匿名放行，结果不可晋升）
AUTH_MODE=
# JobStore（v0.8.4）：Canonical IR 存服务端数据库，jobId 为不透明 UUID。
# 【生产必填】PostgreSQL 连接串。未配置时生产环境启动失败（Serverless 多实例不共享内存/本地文件）
DATABASE_URL=
# 【仅本地开发】node:sqlite 文件路径；生产环境设置此项会直接报错
JOBSTORE_FILE=
# PG 连接池上限（Serverless 建议 1-3）
PGPOOL_MAX=
# ezPLM 会话 JWT 校验：【生产必填】未配置 iss/aud 时生产环境拒绝所有请求
EZPLM_JWT_ISS=
EZPLM_JWT_AUD=
# OCR Worker 端点（item 12）：未配置时需 OCR 的页仍会保留送模型读图并标记 ocr_pending
OCR_ENDPOINT=
# P0-5 ezPLM 宿主 origin 白名单（逗号分隔），入站 postMessage 校验 + 出站精确 targetOrigin
VITE_EZPLM_ORIGINS=
# 解析器切换：inspector = pdf-inspector 原生适配器（仅 Worker/本地，Vercel 勿开）
PDF_PARSER=

# fetch-pdf 短期令牌 HMAC 密钥（未配置则用进程随机值，重启后旧令牌失效）
PDF_TOKEN_SECRET=

# 资产下载令牌密钥（v0.8.5 item 9）：与 tenant/job/revision 绑定的短期令牌。生产必填（可复用 PDF_TOKEN_SECRET）
ASSET_TOKEN_SECRET=
# 真实 PostgreSQL 集成测试（npm run test:pg）；未配置时 PG 测试整体 skip 并标记 NOT VERIFIED
TEST_DATABASE_URL=

# 测试专用 Stub（item 10）：让 live / degraded 走真实服务端分支而不调用真实 Gemini
# GEMINI_STUB=<json>          → 返回该 JSON（模拟 live 成功）
# GEMINI_STUB=throw:<message> → 抛错（触发 degraded 分支）
GEMINI_STUB=
# OCR Stub（pages 数组 JSON），用于验证 OCR 合并与重解析链路
OCR_STUB=

# 对象存储（v0.8.7 item 8）：Figure PNG 等二进制资产不入 IR，只存对象键 + SHA256
# 本地开发默认使用文件目录；生产建议接 S3 兼容存储
OBJECT_STORE_DIR=/tmp/ds2kicad-objects
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
