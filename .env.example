# ===== Connectivity Intelligence Engine 环境变量（Vercel → Project Settings → Environment Variables）=====

# Gemini API Key。缺省不自动 Mock：未配置且未显式 MOCK_MODE=1 时 AI 提取接口返回 503
GEMINI_API_KEY=
# Datasheet / 低成本结构提取模型
GEMINI_MODEL=gemini-2.5-flash
# Connectivity 视觉提取模型；留空则复用 GEMINI_MODEL
SCHEMATIC_MODEL=
# 可选：主模型超时/429/5xx 后切换的备用模型；不填则重试主模型
SCHEMATIC_FALLBACK_MODEL=
# Connectivity 提取总预算。Vercel api/schematic-convert.js maxDuration=180s，默认给模型 145s。
SCHEMATIC_EXTRACT_BUDGET_MS=145000
# 单次模型调用上限；默认两次自适应重试，每次最多约 68s
SCHEMATIC_ATTEMPT_TIMEOUT_MS=68000
SCHEMATIC_AI_ATTEMPTS=2
# Connectivity-first 默认采用紧凑 JSON，减少生成时延；full 可恢复较完整描述字段
SCHEMATIC_EXTRACTION_DETAIL=compact
# 默认从 24576 下调到 12288，优先把完整连接图返回；复杂大图可按需提高
SCHEMATIC_MAX_OUTPUT_TOKENS=12288
# 可选：模型支持时限制 thinking budget；留空则由模型默认处理
SCHEMATIC_THINKING_BUDGET=
# URL PDF 下载超时
SCHEMATIC_DOWNLOAD_TIMEOUT_MS=28000
# 1=使用内置样例；Mock 不扣 Credit
MOCK_MODE=0

ALLOWED_ORIGINS=
MAX_PDF_MB=15
PORT=3001
# Datasheet: 1=程序化解析优先，AI 仅补缺；0=全量走模型
DETERMINISTIC_FIRST=1
EXTRACT_BUDGET_MS=50000

# ===== ezPLM / eeHub 会话 =====
EZPLM_JWT_SECRET=
AUTH_MODE=
EZPLM_JWT_ISS=
EZPLM_JWT_AUD=

# ===== Guest / Handoff =====
ALLOW_GUEST_TRIAL=1
GUEST_SESSION_SECRET=
GUEST_SESSION_TTL_SEC=2592000
HANDOFF_TOKEN_SECRET=
HANDOFF_TOKEN_TTL_SEC=600
EZPLM_SIGNUP_URL=https://www.ezplm.cn/
EEHUB_SIGNUP_URL=https://www.eehub.io/

# ===== Credit / Billing =====
# 测试阶段默认 0：记录成本规则但不扣额度、不阻塞任务。
# 正式开放/上线时改成 1 即启用现有 Reserve → Commit / Refund 计费链路。
CREDIT_ENFORCEMENT=0
# 测试页面展示的充足额度；不实际扣减。
TEST_CREDIT_BALANCE=100000
# 正式启用 CREDIT_ENFORCEMENT=1 后使用以下配置。
GUEST_FREE_CREDITS=3
REGISTERED_FREE_CREDITS=5
COST_DATASHEET_TO_KICAD=1
COST_SCHEMATIC_TO_KICAD=5
GUEST_SCHEMATIC_TRIAL_COST=3
CREDIT_ADMIN_SECRET=

# ===== 持久化 =====
DATABASE_URL=
JOBSTORE_FILE=
PGPOOL_MAX=2

# OCR / Parser
OCR_ENDPOINT=
VITE_EZPLM_ORIGINS=
PDF_PARSER=

# PDF / Asset 短期令牌
PDF_TOKEN_SECRET=
ASSET_TOKEN_SECRET=
TEST_DATABASE_URL=

# 测试 Stub
GEMINI_STUB=
SCHEMATIC_GEMINI_STUB=
OCR_STUB=

# 对象存储
OBJECT_STORE_DIR=/tmp/connectivity-intelligence-objects
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
