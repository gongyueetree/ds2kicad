# ===== DS2KiCad 环境变量（Vercel → Project Settings → Environment Variables）=====

# Gemini API Key（必填）。缺省不自动 Mock：未配置且未显式 MOCK_MODE=1 时 /api/extract 返回 503
GEMINI_API_KEY=
# Gemini 模型（可选，默认 gemini-2.5-flash）
GEMINI_MODEL=gemini-2.5-flash
# 强制演示模式：1 = 返回内置 TMUXL27518 样例；Mock 不扣 Credit
MOCK_MODE=0

# 允许跨域来源（逗号分隔）。推荐至少包含 EETree / Tindie / ezPLM / eeHub 的实际宿主 Origin。
ALLOWED_ORIGINS=
# PDF 下载上限（MB，默认 15）
MAX_PDF_MB=15
# 本地开发 API 端口
PORT=3001
# 混合提取策略：1=程序化解析优先，AI 仅按需补缺；0=全量走 Gemini
DETERMINISTIC_FIRST=1
# 提取接口总时间预算（毫秒），需小于 Vercel 函数时长上限
EXTRACT_BUDGET_MS=50000

# ===== ezPLM / eeHub 已登录会话 =====
# 两个 SaaS 统一签发 HS256 会话 JWT；浏览器不持有密钥。
EZPLM_JWT_SECRET=
AUTH_MODE=
EZPLM_JWT_ISS=
EZPLM_JWT_AUD=

# ===== v1.2 Multi-Channel Guest Trial / Handoff / Credit =====
# 1=允许 EETree/Tindie/Direct 匿名试用；0=关闭
ALLOW_GUEST_TRIAL=1
# Guest 身份 HMAC 密钥。生产必须设置随机强密钥（不要放到 VITE_ 前缀变量）
GUEST_SESSION_SECRET=
# Guest Session 默认 30 天
GUEST_SESSION_TTL_SEC=2592000
# Guest → ezPLM/eeHub 注册接管的一次性/短期 Token 密钥与 TTL
HANDOFF_TOKEN_SECRET=
HANDOFF_TOKEN_TTL_SEC=600
# 匿名首次赠送 / 注册账户首次赠送 Credits
GUEST_FREE_CREDITS=3
REGISTERED_FREE_CREDITS=5
# 操作成本：当前 Datasheet→KiCad 已接入；Schematic→KiCad 为下一阶段预留
COST_DATASHEET_TO_KICAD=1
COST_SCHEMATIC_TO_KICAD=5
# 注册/工作台目标，可替换成实际 signup / callback 页面
EZPLM_SIGNUP_URL=https://www.ezplm.cn/
EEHUB_SIGNUP_URL=https://www.eehub.io/
# 测试/后台充值接口密钥；正式支付系统上线后由 Billing Service 替代
CREDIT_ADMIN_SECRET=

# ===== 持久化 =====
# JobStore + Trial/Credit 均复用 PostgreSQL。Vercel 生产必须配置。
DATABASE_URL=
# 仅本地开发：SQLite JobStore；生产不可使用
JOBSTORE_FILE=
PGPOOL_MAX=2

# OCR Worker 端点；未配置时需 OCR 的页仍会保留送模型读图并标记 ocr_pending
OCR_ENDPOINT=
# iframe/postMessage 宿主白名单（逗号分隔）
# 示例：https://www.ezplm.cn,https://www.eehub.io,https://www.eetree.cn,https://www.tindie.com
VITE_EZPLM_ORIGINS=
# 解析器切换：inspector = pdf-inspector 原生适配器（仅 Worker/本地，Vercel 勿开）
PDF_PARSER=

# PDF / Asset 下载短期令牌
PDF_TOKEN_SECRET=
ASSET_TOKEN_SECRET=
# 真实 PostgreSQL 集成测试；未配置时 PG 测试 skip
TEST_DATABASE_URL=

# 测试专用 Stub
GEMINI_STUB=
OCR_STUB=

# 对象存储（Figure PNG 等二进制资产不入 IR）
OBJECT_STORE_DIR=/tmp/ds2kicad-objects
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
