{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/extract.js": { "maxDuration": 60 },
    "api/platform-extract.js": { "maxDuration": 60 },
    "api/generate.js": { "maxDuration": 30 },
    "api/job-pdf.js": { "maxDuration": 30 },
    "api/figure-upload.js": { "maxDuration": 30 },
    "api/lifecycle.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
